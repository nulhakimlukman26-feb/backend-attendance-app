NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# MySQL (mysql2)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=yourpassword
DB_NAME=attendance_app
#DATABASE_URL=mysql://root:pass@127.0.0.1:3306/attendance_app

JWT_SECRET=replace-with-64-hex-random-min-32-chars
JWT_REFRESH_SECRET=replace-with-64-hex-random-min-32-chars
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d
BCRYPT_ROUNDS=12

# Cloudflare R2 (S3 API) - leave empty to disable R2 and use local skip
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=attendance-app
R2_PUBLIC_URL=

# Optional: encryption key for PII (nik/npwp) - 32 hex chars
PII_ENCRYPTION_KEY=
